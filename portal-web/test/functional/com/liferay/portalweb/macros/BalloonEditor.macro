definition {

	macro addTable {
		VerifyElementPresent.VerifyElementPresent(locator1 = "CKEditor#INSERT_BTN");

		Click.Click(locator1 = "CKEditor#INSERT_BTN");

		Click.Click(locator1 = "CKEditor#INSERT_TABLE_BTN");

		Click.Click(locator1 = "CKEditor#CHK_BTN_TABLE");
	}

	macro clearParagraphWithBackspace {
		TripleClick.TripleClick(locator1 = "CKEditorBalloonEditorSample#BODY_TEXT");

		KeyPress.KeyPress(
			locator1 = "CKEditorBalloonEditorSample#BODY_TEXT",
			value1 = "\BACK_SPACE");
	}

	macro goToAddVideo {
		VerifyElementPresent.VerifyElementPresent(locator1 = "CKEditor#INSERT_BTN");

		Click.Click(locator1 = "CKEditor#INSERT_BTN");

		Click.Click(locator1 = "CKEditor#INSERT_VIDEO_BTN");
	}

	macro toggleBalloonEditorContentStyle {
		TripleClick.TripleClick(locator1 = "CKEditorBalloonEditorSample#BODY_TEXT");

		VerifyElementPresent.VerifyElementPresent(
			key_titleName = "${optionTool}",
			locator1 = "CKEditor#TOOLBAR_ANY_ITEM_BUTTON");

		Click.Click(
			key_titleName = "${optionTool}",
			locator1 = "CKEditor#TOOLBAR_ANY_ITEM_BUTTON");
	}

}