definition {

	macro blacklistModuleAndComponentConfiguration {
		Type.Type(
			key_label = "${label}",
			locator1 = "TextArea#ANY_LABELED",
			value1 = "${symbolicName}");

		SystemSettings.saveConfiguration();
	}

	macro viewProductMenuBlacklistedModule {
		ApplicationsMenuHelper.openApplicationsMenu();

		Navigator.gotoNavTab(navTab = "${panel}");

		AssertElementNotPresent.AssertElementNotPresent(
			key_category = "${category}",
			key_portlet = "${portlet}",
			locator1 = "ApplicationsMenu#PORTLET",
			value1 = "${portlet}");

		AssertConsoleTextPresent.AssertConsoleTextPresent(value1 = "${consoleText}");
	}

}