definition {

	macro addContent {
		SelectFrame.selectFrameNoLoading(locator1 = "IFrame#GOOGLE_DOC");

		if (IsElementPresent.IsElementPresent(locator1 = "GoogleDoc#DISMISS")) {
			Click.Click(locator1 = "GoogleDoc#DISMISS");

			AssertElementPresent.AssertElementPresent(locator1 = "GoogleDoc#INSERT_LINK_BUTTON");
		}

		if (isSet(insertLink)) {
			Click.Click(locator1 = "GoogleDoc#INSERT_LINK_BUTTON");

			Click.Click(locator1 = "GoogleDoc#INSERT_LINK_LINK");

			Type.Type(
				locator1 = "GoogleDoc#INSERT_LINK_LINK",
				value1 = "${linkAddress}");

			Click.Click(locator1 = "GoogleDoc#INSERT_LINK_TEXT");

			Type.Type(
				locator1 = "GoogleDoc#INSERT_LINK_TEXT",
				value1 = "${linkText}");

			Click.Click(locator1 = "GoogleDoc#INSERT_LINK_APPLY_BUTTON");
		}

		SelectFrameTop.SelectFrameTop();
	}

	macro discardChanges {
		var key_text = "Discard Changes";

		AssertElementPresent.AssertElementPresent(locator1 = "Button#ANY");

		AssertClick.AssertClick(
			locator1 = "Button#ANY",
			value1 = "Discard Changes");
	}

	macro editTitleInGoogleDoc {
		SelectFrame.selectFrameNoLoading(locator1 = "IFrame#GOOGLE_DOC");

		Click.Click(locator1 = "GoogleDoc#TITLE");

		Type.Type(
			locator1 = "GoogleDoc#TITLE",
			value1 = "${dmDocumentTitle}");

		KeyPress.KeyPress(
			locator1 = "GoogleDoc#TITLE",
			value1 = "\RETURN");

		SelectFrameTop.SelectFrameTop();

		Refresh.Refresh();
	}

	macro gotoEdit {
		var key_dmDocumentTitle = "${dmDocumentTitle}";

		Click.Click(locator1 = "DocumentsAndMedia#DESCRIPTIVE_LIST_DOCUMENT_VERTICAL_ELLIPSIS");

		MenuItem.click(menuItem = "Edit in ${dmDocumentTypeName}");

		var siteName = TestCase.getSiteName(siteName = "${siteName}");

		Pause.Pause(locator1 = "5000");

		if (IsElementNotPresent.IsElementNotPresent(key_text = "Save and Return to ${siteName}", locator1 = "Button#ANY")) {
			Refresh.Refresh();

			Click.Click(locator1 = "DocumentsAndMedia#DESCRIPTIVE_LIST_DOCUMENT_VERTICAL_ELLIPSIS");

			MenuItem.click(menuItem = "Edit in ${dmDocumentTypeName}");
		}

		AssertElementPresent.AssertElementPresent(
			key_text = "Save and Return to ${siteName}",
			locator1 = "Button#ANY");
	}

	macro saveAndExit {
		var siteName = TestCase.getSiteName(siteName = "${siteName}");
		var key_text = "Save and Return to ${siteName}";

		AssertElementPresent.AssertElementPresent(locator1 = "Button#ANY");

		AssertClick.AssertClick(
			locator1 = "Button#ANY",
			value1 = "Save and Return to ${siteName}");

		Alert.viewSuccessMessage();

		WaitForElementNotPresent.WaitForElementNotPresent(
			locator1 = "Button#ANY",
			value1 = "Save and Return to ${siteName}");

		Navigator.openURL();
	}

}