definition {

	macro assertNoApplicationsMenu {
		AssertElementNotPresent.AssertElementNotPresent(locator1 = "ApplicationsMenu#APPLICATIONS_MENU");
	}

	macro closeApplicationsMenu {
		if (IsElementPresent.IsElementPresent(locator1 = "ApplicationsMenu#APPLICATIONS_MENU")) {
			Click.Click(locator1 = "ApplicationsMenu#TOGGLE");
		}

		WaitForElementNotPresent.WaitForElementNotPresent(locator1 = "ApplicationsMenu#APPLICATIONS_MENU");
	}

	macro gotoPortlet {
		Click.Click(
			key_category = "${category}",
			key_portlet = "${portlet}",
			locator1 = "ApplicationsMenu#PORTLET");
	}

	macro openApplicationsMenu {
		if (IsElementNotPresent.IsElementNotPresent(locator1 = "ApplicationsMenu#APPLICATIONS_MENU")) {
			Click.Click(locator1 = "ApplicationsMenu#TOGGLE");
		}

		WaitForElementPresent.WaitForElementPresent(locator1 = "ApplicationsMenu#APPLICATIONS_MENU");
	}

	macro openWorkspace {
		if (IsElementNotPresent.IsElementNotPresent(locator1 = "Portlet#MODAL_TITLE")) {
			Click.Click(locator1 = "ApplicationsMenu#VIEW_ALL_LINK");

			AssertVisible.AssertVisible(locator1 = "Portlet#MODAL_TITLE");
		}
	}

}