	macro editStagingConfiguration {
		LexiconEntry.gotoHeaderMenuItem(menuItem = "Staging Configuration");

		if ("${pageVersioningEnabled}" == "true") {
			Check.checkHiddenToggleSwitch(locator1 = "Checkbox#ENABLED_ON_PUBLIC_PAGES");

			Check.checkHiddenToggleSwitch(locator1 = "Checkbox#ENABLED_ON_PRIVATE_PAGES");
		}

		if (isSet(isNotEditable)) {
			var key_contentName = "${isNotEditable}";

			AssertNotEditable.AssertNotEditable(locator1 = "Checkbox#STAGED_CONTENT");
		}

		Button.clickSave();

		Pause.Pause(locator1 = "5000");
	}

	macro enablePageInSitePagesVariation {
		AssertTextEquals.assertPartialText(
			locator1 = "Staging#STAGING_BAR_PAGE_VARIATIONS_ALERT",
			value1 = "The page ${pageName} is not enabled in ${sitePagesVariationName}, but is available for other pages variations.");

		AssertClick.AssertClick(
			locator1 = "Staging#STAGING_MENU_ENABLE_PAGE_BUTTON",
			value1 = "Enable in ${sitePagesVariationName}");

		Page.view(
			pageName = "${pageName}",
			privacy = "${privacy}");
	}

	macro gotoHistory {
		while (IsElementNotPresent.IsElementNotPresent(locator1 = "Staging#HISTORY_BUTTON")) {
			Click.Click(locator1 = "Icon#STAGING_BAR_VERTICAL_ELLIPSIS");
		}

		Click.Click(locator1 = "Staging#HISTORY_BUTTON");

		SelectFrame.SelectFrame(locator1 = "IFrame#METADATA_SETS_IFRAME");
	}

	macro gotoNavTab {
		var key_tabName = "${tabName}";

		if (IsElementNotPresent.IsElementNotPresent(locator1 = "StagingPublishToLive#ACTIVE_TAB_NAME")) {
			Click.Click(locator1 = "StagingPublishToLive#TAB_NAME");
		}

		AssertElementPresent.AssertElementPresent(locator1 = "StagingPublishToLive#ACTIVE_TAB_NAME");
	}

	macro gotoPublishToLive {
		if ((IsElementNotPresent.IsElementNotPresent(locator1 = "Staging#STAGING_PUBLISH_TO_LIVE_BUTTON")) && (IsElementPresent.IsElementPresent(locator1 = "Icon#STAGING"))) {
			Click.Click(locator1 = "Icon#STAGING");

			AssertElementPresent.AssertElementPresent(locator1 = "Staging#STAGING_PUBLISH_TO_LIVE_BUTTON");
		}

		if ((IsElementPresent.IsElementPresent(locator1 = "Staging#STAGING_MENU_READY_FOR_PUBLICATION")) && !(isSet(pleaseDoNotMarkAsReady))) {
			Check.toggleSwitch(locator1 = "Staging#STAGING_MENU_READY_FOR_PUBLICATION");
		}

		WaitForLiferayEvent.initializeLiferayEventLog();

		Click.Click(locator1 = "Staging#STAGING_PUBLISH_TO_LIVE_BUTTON");

		SelectFrame.SelectFrame(locator1 = "IFrame#MODAL_BODY");
	}

	macro markAsReadyForPublication {
		if (IsElementPresent.IsElementPresent(locator1 = "Staging#STAGING_MENU_READY_FOR_PUBLICATION")) {
			AssertNotChecked.AssertNotChecked(locator1 = "Staging#STAGING_MENU_READY_FOR_PUBLICATION");

			Check.toggleSwitch(locator1 = "Staging#STAGING_MENU_READY_FOR_PUBLICATION");
		}
	}

	macro mergeSitePagesVariation {
		Refresh.Refresh();

		Staging.navigateToSitePageVariation();

		LexiconEntry.gotoEntryMenuItemNoWait(
			menuItem = "Merge",
			rowEntry = "${sitePagesVariationName}");

		var key_sitePagesVariationMergeName = "${sitePagesVariationMergeName}";

		AssertTextEquals.AssertTextEquals(
			locator1 = "StagingManageVariations#MERGE_SITE_PAGES_VARIATION_TABLE_BRANCH",
			value1 = "${sitePagesVariationMergeName}");

		AssertClickNoError.AssertClickNoError(
			locator1 = "StagingManageVariations#MERGE_SITE_PAGES_VARIATION_TABLE_SELECT_LINK",
			value1 = "Select");

		AssertConfirm.AssertConfirm(value1 = "Are you sure you want to merge changes from ${sitePagesVariationMergeName}?");

		Staging.viewVariationSuccessMessage();

		IFrame.closeFrame();
	}

	macro modifyVariation {
		LexiconEntry.gotoHeaderMenuItem(menuItem = "Staging Configuration");

		if (isSet(enableOnPublicPages)) {
			Click.Click(locator1 = "Checkbox#ENABLED_ON_PUBLIC_PAGES");

			AssertClickNoError.AssertClickNoError(
				locator1 = "Button#SAVE",
				value1 = "Save");
		}

		if (isSet(enableOnPrivatePages)) {
			Click.Click(locator1 = "Checkbox#ENABLED_ON_PRIVATE_PAGES");

			AssertClickNoError.AssertClickNoError(
				locator1 = "Button#SAVE",
				value1 = "Save");
		}
	}

	macro moveToTheRecycleBinPublishTemplate {
		LexiconEntry.gotoHeaderMenuItem(menuItem = "Publish Templates");

		LexiconEntry.gotoEntryMenuItem(
			menuItem = "Move to Recycle Bin",
			rowEntry = "${publishTemplateName}");

		Alert.viewSuccessMessage();
	}

	macro navigateToSitePageVariation {
		WaitForLiferayEvent.initializeLiferayEventLog();

		Click.Click(locator1 = "Icon#STAGING_BAR_VERTICAL_ELLIPSIS");

		Click.Click(locator1 = "Staging#MANAGE_VARIATIONS");

		SelectFrame.SelectFrame(locator1 = "IFrame#SITE_VARIATION_IFRAME");
	}

	macro openStagingAdmin {
		Navigator.openWithAppendToBaseURL(urlAppend = "group/${siteURLKey}/~/control_panel/manage?p_p_id=com_liferay_staging_processes_web_portlet_StagingProcessesPortlet");
	}

	macro publishCustomPublication {
		Staging.addCustomPublication(headerTitle = "${headerTitle}");

		if (isSet(scheduleProcess)) {
			Staging.configureScheduleTime();
		}

		if ("${rangeAll}" == "true") {
			Click.Click(locator1 = "Radio#CHOOSE_CONTENT_ALL_CHANGE");

			Click.Click(locator1 = "Link#REFRESH_COUNTS");
		}

		if (isSet(checkContentNameList)) {
			for (var contentName : list "${checkContentNameList}") {
				Check.Check(
					key_contentName = "${contentName}",
					locator1 = "Staging#STAGING_CONTENT_CHECKBOX");
			}
		}

		Staging.clickPublishToLiveButton(
			failureExpected = "${failureExpected}",
			remoteStaging = "${remoteStaging}",
			scheduleProcess = "${scheduleProcess}");

		Staging.viewProcessResult(
			failureExpected = "${failureExpected}",
			inProcess = "${inProcess}",
			scheduleProcess = "${scheduleProcess}",
			validateErrorMessage = "${validateErrorMessage}");
	}

	macro publishToLive {
		if (isSet(publicationName)) {
			PortletEntry.inputName(name = "${publicationName}");
		}

		Staging.clickPublishToLiveButton(remoteStaging = "${remoteStaging}");

		Staging.viewProcessResult(
			failureExpected = "${failureExpected}",
			scheduleProcess = "${scheduleProcess}",
			validateErrorMessage = "${validateErrorMessage}");

		SelectFrameTop.SelectFrameTop();

		if (IsElementPresent.IsElementPresent(locator1 = "IFrame#MODAL_BODY")) {
			IFrame.closeFrame();
		}

		WaitForLiferayEvent.initializeLiferayEventLog();
	}

	macro publishToLiveNowViaPortletCP {
		LexiconEntry.gotoHeaderMenuItem(menuItem = "Staging");

		WaitForLiferayEvent.initializeLiferayEventLog();

		SelectFrame.SelectFrame(locator1 = "IFrame#CONFIGURATION_DIALOG");

		if ("${replicateIndividualDeletions}" == "true") {
			AssertVisible.AssertVisible(locator1 = "Staging#STAGING_CONTENT_DELETIONS");

			Click.Click(locator1 = "Staging#STAGING_CONTENT_DELETIONS");

			Click.Click(locator1 = "Staging#REPLICATE_INDIVIDUAL_DELETIONS");
		}

		ClickNoError.ClickNoError(locator1 = "Staging#STAGING_PUBLISH_TO_LIVE_BUTTON");

		Confirm.Confirm(value1 = "Are you sure you want to publish to live and update the existing application data?");

		Pause.Pause(locator1 = "5000");

		AssertTextEquals.AssertTextEquals(
			locator1 = "Staging#STAGING_STATUS_PORTLET",
			value1 = "Successful");

		IFrame.closeFrame();
	}

	macro publishToLiveNowViaPortletPG {
		Portlet.gotoPortletOptions(
			portletName = "${portletName}",
			portletOption = "Staging");

		IFrame.selectConfigurationFrame();

		AssertClickNoError.AssertClickNoError(
			locator1 = "Staging#STAGING_PUBLISH_TO_LIVE_BUTTON",
			value1 = "Publish to Live");

		AssertConfirm.AssertConfirm(value1 = "Are you sure you want to publish to live and update the existing application data?");

		Pause.Pause(locator1 = "5000");

		AssertTextEquals.AssertTextEquals(
			locator1 = "Staging#STAGING_STATUS_PORTLET",
			value1 = "Successful");

		IFrame.closeFrame();
	}

	macro publishToLivePublishTemplate {
		if (IsElementPresent.IsElementPresent(locator1 = "StagingPublishToLive#SWITCH_TO_ADVANCED_PUBLICATION")) {
			AssertClick.assertPartialTextClickAt(
				locator1 = "StagingPublishToLive#SWITCH_TO_ADVANCED_PUBLICATION",
				value1 = "Switch to Advanced Publish Process");

			AssertClick.AssertClick(
				locator1 = "StagingPublishToLive#PUBLISH_TEMPLATES_BUTTON",
				value1 = "Publish Templates");
		}

		Click.Click(locator1 = "Icon#HISTORY_VERTICAL_ELLIPSIS");

		Click.Click(locator1 = "StagingPublishToLive#PUBLISH_TEMPLATES_TABLE_PUBLISH_TO_LIVE_ARROW_BUTTON");

		AssertClick.AssertClick(
			locator1 = "Staging#STAGING_PUBLISH_TO_LIVE_BUTTON",
			value1 = "Publish to Live");

		while ((IsElementNotPresent.IsElementNotPresent(locator1 = "Staging#PROCESS_SUCCESSFUL")) && (IsElementNotPresent.IsElementNotPresent(locator1 = "Staging#LATEST_PROCESS_RESULT"))) {
			Pause.Pause(locator1 = "1000");
		}

		if (IsElementPresent.IsElementPresent(locator1 = "Staging#PROCESS_SUCCESSFUL")) {
			AssertTextEquals.AssertTextEquals(
				locator1 = "Staging#PROCESS_SUCCESSFUL",
				value1 = "Successful");

			SelectFrame.SelectFrame(value1 = "relative=top");

			IFrame.closeFrame();
		}
		else {
			AssertTextEquals.AssertTextEquals(
				locator1 = "Staging#LATEST_PROCESS_RESULT",
				value1 = "SUCCESSFUL");
		}

		var key_siteName = "${siteName}";

		ProductMenu.gotoPortlet(
			category = "Publishing",
			portlet = "Staging");

		if (IsElementPresent.IsElementPresent(locator1 = "Staging#LATEST_PROCESS_RESULT")) {
			AssertTextEquals.AssertTextEquals(
				locator1 = "Staging#LATEST_PROCESS_RESULT",
				value1 = "SUCCESSFUL");
		}
		else {
			AssertTextEquals.AssertTextEquals(
				locator1 = "Staging#PROCESS_SUCCESSFUL",
				value1 = "Successful");
		}
	}

	macro publishToRemoteUncheckContentViaCustomPublication {
		LexiconEntry.gotoAdd();

		var key_contentName = "${contentName}";

		Uncheck.Uncheck(locator1 = "Staging#STAGING_CONTENT_CHECKBOX");

		AssertNotChecked.AssertNotChecked(locator1 = "Staging#STAGING_CONTENT_CHECKBOX");

		AssertClickNoError.AssertClickNoError(
			locator1 = "Staging#STAGING_PUBLISH_TO_REMOTE_LIVE_BUTTON",
			value1 = "Publish to Remote Live");

		Pause.Pause(locator1 = "5000");

		AssertTextEquals.AssertTextEquals(
			locator1 = "Staging#PROCESS_RESULT",
			value1 = "SUCCESSFUL");
	}

	macro publishViaSAP {
		if (IsElementPresent.IsElementPresent(key_rowEntry = "${entry}", locator1 = "Icon#ROW_VERTICAL_ELLIPSIS")) {
			Click.Click(
				key_rowEntry = "${entry}",
				locator1 = "Icon#ROW_VERTICAL_ELLIPSIS");

			MenuItem.clickNoError(menuItem = "Publish to Live");
		}
		else {
			WebContentNavigator.gotoEntryMenuItem(
				entry = "${entry}",
				menuItem = "Publish to Live");
		}

		AssertConfirm.AssertConfirm(value1 = "${confirmMessage}");

		AssertTextEquals.AssertTextEquals(
			locator1 = "Staging#PROCESS_SUCCESSFUL",
			value1 = "Successful");
	}

	macro redoStagingPageVersioningPG {
		while (IsElementNotPresent.IsElementNotPresent(locator1 = "Staging#STAGING_MENU_REDO_BUTTON")) {
			Click.Click(locator1 = "Icon#STAGING_BAR_VERTICAL_ELLIPSIS");
		}

		ClickNoError.ClickNoError(locator1 = "Staging#STAGING_MENU_REDO_BUTTON");

		AssertConfirm.AssertConfirm(value1 = "Are you sure you want to redo your last changes?");
	}

	macro remoteStagingSetUp {
		if (!(isSet(remotePort))) {
			var remotePort = "8080";
		}

		JSONGroup.addGroup(
			groupName = "Remote Site",
			portalURL = "http://localhost:${remotePort}");

		var siteID = JSONGroupSetter.setGroupId(groupName = "Remote Site", portalURL = "http://localhost:${remotePort}");
		var siteURLKey = ContentPagesNavigator._convertNameToKey(name = "${siteName}");

		Staging.openStagingAdmin(siteURLKey = "${siteURLKey}");

		Staging.activateStagingCP(
			contentName = "${contentName}",
			pageVersioningEnabled = "${pageVersioningEnabled}",
			remotePort = "${remotePort}",
			remoteStaging = "true",
			siteID = "${siteID}",
			siteName = "${siteName}",
			uncheckContent = "${uncheckContent}");
	}

	macro remoteStagingSetUpViaJson {
		if (!(isSet(remotePort))) {
			var remotePort = "8080";
		}

		JSONGroup.addGroup(
			groupName = "Remote Site",
			portalURL = "http://localhost:${remotePort}");

		var remoteGroupId = JSONGroupSetter.setGroupId(groupName = "Remote Site", portalURL = "http://localhost:${remotePort}");

		JSONStaging.enableRemoteStaging(
			branchingPrivate = "${branchingPrivate}",
			branchingPublic = "${branchingPublic}",
			groupName = "${groupName}",
			parentGroupName = "${parentGroupName}",
			remoteGroupId = "${remoteGroupId}",
			remotePort = "${remotePort}");
	}

	macro runGroovyScript {
		ServerAdministration.openServerAdmin();

		var script = TestCase.getFileContent(fileName = "create-400-web-content-articles.groovy");

		Navigator.gotoNavItem(navItem = "Script");

		Select.Select(
			locator1 = "ServerAdministrationScript#LANGUAGE_SELECT",
			value1 = "Groovy");

		Type.Type(
			locator1 = "ServerAdministrationScript#SCRIPT_TEXT",
			value1 = "${script}");

		AssertClick.AssertClick(
			locator1 = "ServerAdministrationScript#EXECUTE_BUTTON",
			value1 = "Execute");

		while (IsElementNotPresent.IsElementNotPresent(locator1 = "Message#SUCCESS_DISMISSIBLE")) {
			Pause.Pause(locator1 = "4000");
		}
	}

	macro saveLocalStagingConfiguration {
		AssertClickNoError.AssertClickNoError(
			locator1 = "Button#SAVE",
			value1 = "Save");

		AssertConfirm.AssertConfirm(value1 = "Are you sure you want to activate local staging for ${siteName}?");

		while (IsElementNotPresent.IsElementNotPresent(locator1 = "Staging#PROCESS_SUCCESSFUL")) {
			Pause.Pause(locator1 = "1000");
		}

		AssertTextEquals.AssertTextEquals(
			locator1 = "Staging#PROCESS_RESULT",
			value1 = "SUCCESSFUL");
	}

	macro savePublishTemplate {
		Button.clickSave();

		var key_publishTemplateName = "${publishTemplateName}";

		AssertTextEquals.AssertTextEquals(
			locator1 = "StagingPublishToLive#PUBLISH_TEMPLATES_TABLE_NAME",
			value1 = "${publishTemplateName}");

		AssertTextEquals.AssertTextEquals(
			locator1 = "StagingPublishToLive#PUBLISH_TEMPLATES_TABLE_DESCRIPTION",
			value1 = "${publishTemplateDescription}");
	}

	macro saveRemoteStagingConfiguration {
		AssertClickNoError.AssertClickNoError(
			locator1 = "Button#SAVE",
			value1 = "Save");

		AssertConfirm.AssertConfirm(value1 = "Are you sure you want to activate remote staging for ${siteName}?");

		while (IsElementNotPresent.IsElementNotPresent(locator1 = "Message#SUCCESS")) {
			Pause.Pause(locator1 = "1000");
		}

		if (IsElementPresent.IsElementPresent(locator1 = "Button#CLOSE_MESSAGE")) {
			Click.Click(locator1 = "Button#CLOSE_MESSAGE");
		}
	}

	macro schedulePublishToLivePG {
		if (IsElementPresent.IsElementPresent(locator1 = "Staging#STAGING_MENU_READY_FOR_PUBLICATION")) {
			Check.toggleSwitch(locator1 = "Staging#STAGING_MENU_READY_FOR_PUBLICATION");
		}

		Click.Click(locator1 = "Staging#STAGING_PUBLISH_TO_LIVE_BUTTON");

		SelectFrame.SelectFrame(locator1 = "IFrame#MODAL_BODY");

		Click.Click(locator1 = "StagingPublishToLive#SWITCH_TO_ADVANCED_PUBLICATION");

		Click.Click(locator1 = "PagesConfiguration#PAGES_ALL_PUBLIC_PAGES_CHECKBOX");

		Staging.configureScheduleTime(scheduleTitleName = "${scheduleTitleName}");

		if (isSet(frequency)) {
			Select.Select(
				locator1 = "StagingPublishToLive#DATE_SCHEDULE_REPEAT_DROPDOWN",
				value1 = "${frequency}");
		}

		if (isSet(checkContentNameList)) {
			for (var contentName : list "${checkContentNameList}") {
				var key_contentName = "${contentName}";

				Click.Click(locator1 = "PagesConfiguration#CONTENT_CHOOSE_CONTENT_CONTENT_CHECKBOX");
			}
		}

		AssertClick.AssertClick(
			locator1 = "StagingPublishToLive#ADD_EVENT_BUTTON",
			value1 = "Add Event");

		Alert.viewSuccessMessage();

		SelectFrameTop.SelectFrameTop(value1 = "relative=top");

		Pause.Pause(locator1 = "5000");
	}

	macro searchPublishTemplate {
		LexiconEntry.gotoHeaderMenuItem(menuItem = "Publish Templates");

		Pause.Pause(locator1 = "3000");

		Search.searchCP(searchTerm = "${searchTerm}");

		var key_publishTemplateName = "${searchTerm}";

		AssertTextEquals.assertPartialText(
			locator1 = "StagingPublishToLive#PUBLISH_TEMPLATES_TABLE_NAME",
			value1 = "${searchTerm}");
	}

	macro setStartDateTomorrow {
		Click.Click(locator1 = "StagingPublishToLive#DATE_SCHEDULE_START_DATE");

		var daySelected = selenium.getText("CalendarEditEvent#MINI_CALENDAR_DAY_SELECTED");
		var tomorrow = ${daySelected} + 1;
		var key_daySpecific = "${tomorrow}";

		if (IsElementPresent.IsElementPresent(locator1 = "CalendarEditEvent#MINI_CALENDAR_DAY_SPECIFIC")) {
			Click.Click(locator1 = "CalendarEditEvent#MINI_CALENDAR_DAY_SPECIFIC");
		}
		else {
			Click.Click(locator1 = "CalendarEditEvent#MINI_CALENDAR_NEXT_MONTH_BUTTON");

			var key_daySpecific = "1";

			Click.Click(locator1 = "CalendarEditEvent#MINI_CALENDAR_DAY_SPECIFIC");
		}
	}

	macro submitForPublicationPageRevision {
		if (IsTextEqual.IsTextEqual(locator1 = "Message#WORKFLOW_STATUS", value1 = "Draft")) {
			AssertClick.AssertClick(
				locator1 = "Staging#STAGING_MENU_SUBMIT_FOR_PUBLICATION",
				value1 = "Submit for Publication");
		}

		AssertElementNotPresent.AssertElementNotPresent(locator1 = "Staging#STAGING_MENU_SUBMIT_FOR_PUBLICATION");

		if (IsTextEqual.IsTextEqual(locator1 = "Message#WORKFLOW_STATUS", value1 = "Pending (Created)")) {
			AssertTextEquals.AssertTextEquals(
				locator1 = "Message#WORKFLOW_STATUS",
				value1 = "Pending (Created)");
		}
		else {
			AssertTextEquals.AssertTextEquals(
				locator1 = "Message#WORKFLOW_STATUS",
				value1 = "Pending (Review)");
		}
	}

	macro undoStagingPageVersioningPG {
		Click.Click(locator1 = "Icon#HISTORY_VERTICAL_ELLIPSIS");

		ClickNoError.ClickNoError(locator1 = "Staging#STAGING_MENU_UNDO_BUTTON");

		AssertConfirm.AssertConfirm(value1 = "Are you sure you want to undo your last changes?");
	}

	macro viewAddButtonDoesNotExist {
		IsElementNotPresent.IsElementNotPresent(locator1 = "Button#PLUS");
	}

	macro viewAddButtonExists {
		AssertVisible.AssertVisible(locator1 = "Button#PLUS");
	}

	macro viewDateRange {
		AssertElementPresent.AssertElementPresent(
			key_dateRangeStartDate = "${dateRangeStartDate}",
			locator1 = "Select#DATE_RANGE_START_DATE_VALUE");

		AssertElementPresent.AssertElementPresent(
			key_dateRangeEndDate = "${dateRangeEndDate}",
			locator1 = "Select#DATE_RANGE_END_DATE_VALUE");
	}

	macro viewDefaultConfiguration {
		for (var configurationName : list "${configurationNameList}") {
			var key_checkboxName = "${configurationName}";

			AssertChecked.AssertChecked(locator1 = "StagingPublishToLive#STAGING_CONFIGURATION_CHECKBOX");
		}
	}

	macro viewEditedSitePagesVariationPG {
		var key_sitePagesVariationName = "${sitePagesVariationName}";

		AssertTextEquals.assertPartialText(
			locator1 = "Staging#SITE_PAGES_VARIATION",
			value1 = "${sitePagesVariationName}");
	}

	macro viewHistoryVersionPG {
		if (IsElementPresent.IsElementPresent(locator1 = "Icon#STAGING_BAR_VERTICAL_ELLIPSIS")) {
			Staging.gotoHistory();
		}

		if ("${modifiedVersion}" == "true") {
			AssertTextNotEquals.AssertTextNotEquals(
				locator1 = "Staging#HISTORY_VERSION",
				value1 = "${historyVersion}");
		}
		else if (isSet(historyVersionName)) {
			var key_historyVersionName = "${historyVersionName}";

			AssertTextEquals.assertPartialText(
				locator1 = "Staging#HISTORY_VERSION_NAME",
				value1 = "${historyVersionName}");
		}
		else if (IsElementPresent.IsElementPresent(locator1 = "Staging#HISTORY_VERSION_2")) {
			AssertTextEquals.AssertTextEquals(
				locator1 = "Staging#HISTORY_VERSION_2",
				value1 = "${historyVersion}");
		}
		else if (IsElementPresent.isVisible(locator1 = "Staging#HISTORY_VERSION")) {
			AssertTextEquals.AssertTextEquals(
				locator1 = "Staging#HISTORY_VERSION",
				value1 = "${historyVersion}");
		}
		else {
			AssertTextEquals.assertPartialText(
				locator1 = "Staging#HISTORY_VERSION_ANCHOR",
				value1 = "${historyVersion}");
		}

		IFrame.closeFrame();
	}

	macro viewNoPublishContentCountViaPortletStagingCP {
		LexiconEntry.gotoHeaderMenuItem(menuItem = "Staging");

		SelectFrame.SelectFrame(locator1 = "IFrame#CONFIGURATION_DIALOG");

		AssertElementNotPresent.AssertElementNotPresent(locator1 = "Staging#STAGING_CONTENT_COUNT");

		AssertElementNotPresent.AssertElementNotPresent(locator1 = "Staging#STAGING_CONTENT_INFO");

