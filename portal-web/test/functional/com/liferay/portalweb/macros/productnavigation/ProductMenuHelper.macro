definition {

	macro closeProductMenu {
		if (IsElementPresent.IsElementPresent(locator1 = "ProductMenu#PRODUCT_MENU_OPENED")) {
			Click.Click(locator1 = "ProductMenu#TOGGLE");
		}

		AssertElementPresent.AssertElementPresent(locator1 = "ProductMenu#PRODUCT_MENU_CLOSED");
	}

	macro expandCategory {
		var key_category = "${category}";

		if (IsElementPresent.IsElementPresent(locator1 = "ProductMenu#CATEGORY_COLLAPSED")) {
			Click.Click(locator1 = "ProductMenu#CATEGORY_COLLAPSED");
		}

		AssertElementPresent.AssertElementPresent(locator1 = "ProductMenu#CATEGORY_EXPANDED");
	}

	macro expandPanel {
		ProductMenuHelper.openProductMenu();

		var key_panel = StringUtil.toLowerCase("${panel}");
		var key_panel = StringUtil.replace("${key_panel}", " ", "_");

		if (IsElementPresent.IsElementPresent(key_panel = "${key_panel}", locator1 = "ProductMenu#PANEL_COLLAPSED")) {
			Click.Click(
				key_panel = "${key_panel}",
				locator1 = "ProductMenu#PANEL_COLLAPSED");
		}

		AssertElementPresent.AssertElementPresent(
			key_panel = "${key_panel}",
			locator1 = "ProductMenu#PANEL_EXPANDED");
	}

	macro gotoPortlet {
		AssertClick.assertPartialTextClickAt(
			key_portlet = "${portlet}",
			locator1 = "ProductMenu#PORTLET",
			value1 = "${portlet}");
	}

	macro openProductMenu {
		if ((IsElementNotPresent.IsElementNotPresent(locator1 = "ProductMenu#PRODUCT_MENU_OPENED")) && (IsElementPresent.IsElementPresent(locator1 = "ProductMenu#PRODUCT_MENU_CLOSED"))) {
			Click.Click(locator1 = "ProductMenu#TOGGLE");
		}

		AssertElementPresent.AssertElementPresent(locator1 = "ProductMenu#PRODUCT_MENU_OPENED");

		AssertElementNotPresent.AssertElementNotPresent(locator1 = "ProductMenu#PRODUCT_MENU_CLOSED");

		if (IsElementPresent.IsElementPresent(key_text = "Back to Menu", locator1 = "Button#ANY")) {
			Click.Click(
				key_text = "Back to Menu",
				locator1 = "Button#ANY");
		}

		AssertVisible.AssertVisible(locator1 = "ProductMenu#PRODUCT_MENU_BODY");
	}

	macro openWorkspace {
		if (IsElementNotPresent.IsElementNotPresent(locator1 = "Portlet#MODAL_TITLE")) {
			Click.Click(locator1 = "ProductMenu#CHANGE_SPACE_ICON");

			AssertVisible.AssertVisible(locator1 = "Portlet#MODAL_TITLE");
		}
	}

	macro selectScope {
		Click.Click(locator1 = "SiteNavigationMenu#SCOPE_COG");

		Click.Click(
			key_scope = "${scope}",
			locator1 = "ProductMenu#SCOPE");
	}

	macro viewNoSite {
		var key_site = "${site}";

		AssertElementNotPresent.AssertElementNotPresent(locator1 = "ProductMenu#SITE");
	}

}