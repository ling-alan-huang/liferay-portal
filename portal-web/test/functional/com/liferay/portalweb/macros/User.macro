	macro tearDownCP {
		ApplicationsMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Users and Organizations");

		Click.Click(locator1 = "Dropdown#FILTER_AND_ORDER");

		MenuItem.click(menuItem = "Active");

		while (IsElementPresent.IsElementPresent(key_rowNumber = "2", locator1 = "ContentRow#ENTRY_CONTENT_ROW_NUMBER")) {
			Click.waitForMenuToggleJSClick(
				key_rowNumber = "2",
				locator1 = "ContentRow#ENTRY_CONTENT_ROW_NUMBER_ELLIPSIS");

			MenuItem.clickNoError(menuItem = "Deactivate");

			AssertConfirm.AssertConfirm(value1 = "Are you sure you want to deactivate this?");
		}

		Click.Click(locator1 = "Dropdown#FILTER_AND_ORDER");

		MenuItem.click(menuItem = "Inactive");

		if (IsElementPresent.IsElementPresent(locator1 = "ContentRow#ENTRY_CONTENT_ROW_1")) {
			PortletEntry.selectAll();

			ClickNoError.ClickNoError(locator1 = "Icon#DELETE");

			AssertConfirm.AssertConfirm(value1 = "Are you sure you want to permanently delete the selected users?");

			Alert.viewSuccessMessage();
		}

		AssertElementPresent.AssertElementPresent(locator1 = "Message#EMPTY_INFO");
	}

	macro tearDownSpecificUser {
		ApplicationsMenu.gotoPortlet(
			category = "Users",
			panel = "Control Panel",
			portlet = "Users and Organizations");

		Click.Click(locator1 = "Dropdown#FILTER_AND_ORDER");

		MenuItem.click(menuItem = "Active");

		User.searchCP(searchTerm = "${userScreenName}");

		if (IsElementPresent.IsElementPresent(locator1 = "ContentRow#ENTRY_CONTENT_ROW_1")) {
			PortletEntry.selectAll();

			ClickNoError.ClickNoError(locator1 = "Icon#MOVE_TO_RECYCLE_BIN");

			AssertConfirm.AssertConfirm(value1 = "Are you sure you want to deactivate the selected users?");

			Alert.viewSuccessMessage();
		}

		Click.Click(locator1 = "Dropdown#FILTER_AND_ORDER");

		MenuItem.click(menuItem = "Inactive");

		if (IsElementPresent.IsElementPresent(locator1 = "ContentRow#ENTRY_CONTENT_ROW_1")) {
			PortletEntry.selectAll();

			ClickNoError.ClickNoError(locator1 = "Icon#MOVE_TO_RECYCLE_BIN");

			AssertConfirm.AssertConfirm(value1 = "Are you sure you want to permanently delete the selected users?");

			Alert.viewSuccessMessage();
		}
	}

