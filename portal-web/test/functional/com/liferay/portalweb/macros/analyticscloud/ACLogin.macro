definition {

	macro loginAs {
		WaitForPageLoad.WaitForPageLoad();

		if (!(isSet(password))) {
			var password = "test";
		}

		Click.Click(locator1 = "ACLogin#EMAIL_LOGIN_FIELD");

		Type.Type(
			locator1 = "ACLogin#EMAIL_LOGIN_FIELD",
			value1 = "${emailAddress}");

		Click.Click(locator1 = "ACLogin#PASSWORD_LOGIN_FIELD");

		Type.Type(
			locator1 = "ACLogin#PASSWORD_LOGIN_FIELD",
			value1 = "${password}");

		Click.Click(locator1 = "ACLogin#LOGIN_BUTTON");
	}

}