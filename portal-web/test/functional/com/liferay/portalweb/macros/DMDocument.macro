	macro viewCheckedinCP {
		DMDocument.expandInfo();

		AssertTextEquals.AssertTextEquals(
			locator1 = "DocumentsAndMediaDocument#DOCUMENT_INFO_VERSION",
			value1 = "VERSION ${dmDocumentVersionNumber}");

		AssertElementNotPresent.AssertElementNotPresent(locator1 = "Message#INFO");

		if ("${dmRepositoryName}" == "true") {
			AssertTextNotPresent.AssertTextNotPresent(value1 = "You now have an indefinite lock on this document. No one else can edit this document until you unlock it. This lock will never expire.");
		}
		else {
			AssertTextNotPresent.AssertTextNotPresent(value1 = "You now have a lock on this document. No one else can edit this document until you unlock it. This lock will automatically expire in 1 day.");
		}
	}

	macro viewCheckedoutCP {
		if ("${dmRepositoryName}" == "true") {
			AssertTextEquals.assertPartialText(
				locator1 = "Message#INFO",
