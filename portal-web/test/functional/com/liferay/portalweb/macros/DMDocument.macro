	macro expandInfo {
		WaitForPageLoad.WaitForPageLoad();

		if (IsElementPresent.IsElementPresent(locator1 = "Button#INFO")) {
			WaitForElementPresent.WaitForElementPresent(
				key_href = "infoPanel",
				locator1 = "DocumentsAndMedia#DOCUMENT_ANY_HREF");
		}

		if (IsElementNotPresent.IsElementNotPresent(locator1 = "DocumentsAndMedia#SIDEBAR_INFO_ACTIVE")) {
			ManagementBar.clickInfo();
		}

		AssertVisible.AssertVisible(locator1 = "DocumentsAndMedia#SIDEBAR_INFO_ACTIVE");
