	macro setExpirationDate {
		Panel.expandPanel(panel = "Expiration Date");

		if (isSet(enableExpirationDate)) {
			Uncheck.Uncheck(
				checkboxName = "Never Expire",
				locator1 = "Checkbox#ANY_CHECKBOX");
		}

		var displayDateMinute = DateUtil.getFormattedCurrentDate("mm");
		var displayDateHour = DateUtil.getFormattedCurrentDate("HH");
		var displayDateDay = DateUtil.getCurrentDate();
		var displayDateYear = DateUtil.getCurrentYear();
		var displayDateMonth = DateUtil.getCurrentMonth();

		if (isSet(increaseMinutes)) {
			var displayDateMinute = ${displayDateMinute} + ${increaseMinutes};
		}

		if ("${invalidExpirationDate}" == "true") {
			var displayDateYear = ${displayDateYear} - 1;
		}

		var expirationDate = "${displayDateMonth}/${displayDateDay}/${displayDateYear}";
		var expirationDateTime = "${displayDateHour}:${displayDateMinute}";

		Type.Type(
			locator1 = "TextInput#EXPIRATION_DATE",
			value1 = "${expirationDate}");

		Type.Type(
			locator1 = "TextInput#EXPIRATION_DATE_TIME",
			value1 = "${expirationDateTime}");

		Button.clickPublish();

		if ("${invalidExpirationDate}" == "true") {
			AssertTextEquals.assertPartialText(
				key_alertMessage = "Please enter a valid expiration date.",
				locator1 = "Message#ERROR_ENTER_A_VALID_VALUE",
				value1 = "Please enter a valid expiration date.");
		}
		else {
			Alert.viewSuccessMessage();
		}
	}

	macro setReviewDate {
		Panel.expandPanel(panel = "Expiration Date");

		if (isSet(enableReviewDate)) {
			Uncheck.Uncheck(
				checkboxName = "Never Review",
				locator1 = "Checkbox#ANY_CHECKBOX");
		}

		var displayDateMinute = DateUtil.getFormattedCurrentDate("mm");
		var displayDateHour = DateUtil.getFormattedCurrentDate("HH");
		var displayDateDay = DateUtil.getCurrentDate();
		var displayDateYear = DateUtil.getCurrentYear();
		var displayDateMonth = DateUtil.getCurrentMonth();

		if (isSet(increaseMinutes)) {
			var displayDateMinute = ${displayDateMinute} + ${increaseMinutes};
		}

		var reviewDate = "${displayDateMonth}/${displayDateDay}/${displayDateYear}";
		var reviewDateTime = "${displayDateHour}:${displayDateMinute}";

		Type.Type(
			locator1 = "TextInput#REVIEW_DATE",
			value1 = "${reviewDate}");

		Type.Type(
			locator1 = "TextInput#REVIEW_DATE_TIME",
			value1 = "${reviewDateTime}");

		Button.clickPublish();

		Alert.viewSuccessMessage();
	}

	macro setRootFolder {
		Portlet.gotoPortletOptions(portletOption = "Configuration");

		SelectFrame.SelectFrame(locator1 = "DocumentsAndMedia#CONFIGURATION_IFRAME");

		Panel.expandPanel(panel = "Folders Listing");

		AssertClick.AssertClick(
			locator1 = "Button#SELECT",
			value1 = "Select");

		SelectFrame.selectSecondFrame(
			key_title = "Select Folder",
			locator1 = "IFrame#MODAL_ANY");

		AssertClick.AssertClick(
			key_dmFolderName = "${dmRootFolderName}",
			locator1 = "DocumentsAndMedia#SELECT_FOLDER_BUTTON",
			value1 = "Select");

		SelectFrame.SelectFrame(locator1 = "relative=top");

		SelectFrame.SelectFrame(locator1 = "DocumentsAndMedia#CONFIGURATION_IFRAME");

		PortletEntry.save();

		IFrame.closeFrame();
