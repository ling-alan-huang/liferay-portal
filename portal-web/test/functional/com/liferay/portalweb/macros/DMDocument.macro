		Click.Click(locator1 = "Icon#MOVE_TO_RECYCLE_BIN");

		VerifyElementPresent.VerifyElementPresent(locator1 = "Message#SUCCESS");

		if (IsElementNotPresent.IsElementNotPresent(locator1 = "DocumentsAndMedia#ICON_DOCUMENT_GENERIC")) {
			AssertTextEquals.AssertTextEquals(
				locator1 = "Message#EMPTY_INFO",
				value1 = "There are no documents or media files in this folder.");
		}
	}

