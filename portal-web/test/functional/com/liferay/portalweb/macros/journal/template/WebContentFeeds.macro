definition {

	macro addCP {
		LexiconEntry.gotoAdd();

		Type.Type(
			locator1 = "TextInput#NAME",
			value1 = "${feedTitle}");

		Type.Type(
			locator1 = "TextInput#TARGET_PAGE_FRIENDLY_URL",
			value1 = "${pageFriendlyUrl}");

		Panel.expandPanel(panel = "Web Content Constraints");

		WebContentFeeds.selectStructure(structureName = "${structureName}");

		SelectFrame.SelectFrame(value1 = "relative=top");

		PortletEntry.save();
	}

	macro selectStructure {
		var key_ddlDataDefinitionName = "${structureName}";

		Click.Click(
			buttonId = "selectDDMStructure",
			locator1 = "Button#BUTTON_ID");

		SelectFrame.SelectFrame(locator1 = "IFrame#MODAL_BODY");

		ClickNoError.ClickNoError(
			locator1 = "DDMSelectStructure#DDM_STRUCTURE_TABLE_NAME_LINK",
			value1 = "${structureName}");

		AssertConfirm.AssertConfirm(value1 = "Selecting a new structure changes the available templates and available feed item content. Do you want to proceed?");
	}

	macro viewTableEntryCP {
		var key_feedName = "${feedName}";

		AssertTextEquals.AssertTextEquals(
			locator1 = "DDMSelectFeed#FEED_TABLE_NAME",
			value1 = "${feedName}");
	}

}