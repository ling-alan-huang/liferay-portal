		var browserType = PropsUtil.get("browser.type");

		if ("${browserType}" == "safari") {
			Click.Click(locator1 = "DDMEditStructure#SETTINGS_CELL_EDITOR_SAVE_BUTTON");
		}

		AssertTextEquals.AssertTextEquals(
