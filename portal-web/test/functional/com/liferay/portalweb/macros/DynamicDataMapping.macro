	macro makeFieldRequired {
		DoubleClick.DoubleClick(locator1 = "DDMEditStructure#SETTINGS_REQUIRED");

		Click.Click(locator1 = "DDMEditStructure#SETTINGS_CELL_EDITOR_YES_RADIO");

		Click.Click(locator1 = "DDMEditStructure#SETTINGS_CELL_EDITOR_SAVE_BUTTON");

		AssertClick.pauseAssertTextClickAt(
