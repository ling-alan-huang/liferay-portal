	macro editFieldTip {
		DynamicDataMapping.selectDynamicDataMappingFrame();

		DynamicDataMapping.editFieldSettings(fieldFieldLabel = "${fieldFieldLabel}");

		DoubleClick.DoubleClick(locator1 = "DDMEditStructure#SETTINGS_TIP");

