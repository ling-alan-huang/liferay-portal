		else {
			DoubleClick.DoubleClick(locator1 = "DDMEditStructure#FORM_FIELD");
		}

		AssertClick.AssertClick(
			locator1 = "DDMEditStructure#SETTINGS_LINK",
			value1 = "Settings");
	}

