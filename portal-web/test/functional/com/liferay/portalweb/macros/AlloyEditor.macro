definition {

	macro addContent {
		AlloyEditor.typeEditor(
			content = "${content}",
			editor = "content");
	}

	macro addSourceContent {
		AlloyEditor.clickContentField();

		Click.Click(locator1 = "Button#EDITOR_SWITCH");

		Type.typeAceEditor(
			locator1 = "TextArea#ACE_EDITOR",
			value1 = "${content}");
	}

	macro clickContentField {
		Click.Click(
			key_editor = "content",
			locator1 = "AlloyEditor#EDITOR");
	}

	macro typeEditor {
		Type.typeEditor(
			key_editor = "${editor}",
			locator1 = "AlloyEditor#EDITOR",
			value1 = "${content}");
	}

}