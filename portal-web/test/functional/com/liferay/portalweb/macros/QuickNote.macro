definition {

	macro addPG {
		AssertTextEquals.AssertTextEquals(
			locator1 = "QuickNote#NOTE_CONTENT",
			value1 = "Click to edit me...");

		MouseOver.MouseOver(locator1 = "QuickNote#NOTE_CONTENT");

		Click.Click(locator1 = "QuickNote#NOTE_CONTENT_EDITABLE");

		Type.Type(
			locator1 = "TextArea#FIELD_INPUT",
			value1 = "${noteContent}");

		Click.Click(locator1 = "QuickNote#OK_BUTTON");

		AssertTextEquals.AssertTextEquals(
			locator1 = "QuickNote#NOTE_CONTENT",
			value1 = "${noteContent}");
	}

}