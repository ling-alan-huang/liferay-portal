definition {

	macro configureSetupPG {
		Portlet.gotoPortletOptions(
			portletName = "Wiki Display",
			portletOption = "Configuration");

		SelectFrame.SelectFrame(locator1 = "IFrame#MODAL_BODY");

		Select.Select(
			key_selectFieldLabel = "Node",
			locator1 = "Select#ANY",
			value1 = "${wikiNodeName}");

		AssertSelectedLabel.AssertSelectedLabel(
			key_selectFieldLabel = "Node",
			locator1 = "Select#ANY",
			value1 = "${wikiNodeName}");

		Select.Select(
			key_selectFieldLabel = "Page",
			locator1 = "Select#ANY",
			value1 = "${wikiPageName}");

		AssertSelectedLabel.AssertSelectedLabel(
			key_selectFieldLabel = "Page",
			locator1 = "Select#ANY",
			value1 = "${wikiPageName}");

		PortletEntry.save();
	}

}