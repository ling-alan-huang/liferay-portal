definition {

	macro exitWidgetModal {
		SelectFrameTop.SelectFrameTop();

		Click.Click(locator1 = "FormPortlet#WIDGET_MODAL_CLOSE_BUTTON");
	}

	macro gotoSelectForm {
		AssertClick.AssertClick(
			locator1 = "FormPortlet#SELECT_FORM",
			value1 = "Select Form");

		SelectFrame.SelectFrame(locator1 = "IFrame#MODAL_BODY");
	}

}