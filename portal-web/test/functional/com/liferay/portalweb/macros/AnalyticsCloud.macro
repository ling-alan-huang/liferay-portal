definition {

	macro loginAnalyticsCloud {
		Click.Click(locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_USER_LOGIN_FIELD");

		Type.Type(
			locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_USER_LOGIN_FIELD",
			value1 = "${emailAddress}");

		Click.Click(locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_PASSWORD_LOGIN_FIELD");

		Type.Type(
			locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_PASSWORD_LOGIN_FIELD",
			value1 = "${password}");

		Check.Check(locator1 = "AnalyticsCloudConnection#REMEMBER_ME_CHECKBOX");

		Click.Click(locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_LOGIN_BUTTON");
	}

	macro syncAnalyticsCloud {
		ApplicationsMenu.gotoPortlet(
			category = "Configuration",
			panel = "Control Panel",
			portlet = "Instance Settings");

		Click.Click(locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_DXP_BUTTON");

		Click.Click(locator1 = "AnalyticsCloudConnection#DXP_TOKEN_INPUT");

		Paste.Paste(locator1 = "AnalyticsCloudConnection#DXP_TOKEN_INPUT");

		Click.Click(locator1 = "AnalyticsCloudConnection#CONNECT_ANALYTICS_CLOUD_BUTTON");

		AssertTextEquals.AssertTextEquals(
			locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_CONNECTED_CONFIRMATION_MESSAGE",
			value1 = "Your DXP instance is connected to Analytics Cloud.");

		Click.Click(locator1 = "AnalyticsCloudConnection#SYNCED_SITES_LINK");

		Click.Click(locator1 = "AnalyticsCloudConnection#NEW_PROPERTY_BUTTON");

		Click.Click(locator1 = "AnalyticsCloudConnection#SYNCED_SITES_SEARCH_FIELD");

		Type.Type(
			locator1 = "AnalyticsCloudConnection#SYNCED_SITES_SEARCH_FIELD",
			value1 = "${siteName}");

		KeyPress.KeyPress(
			locator1 = "AnalyticsCloudConnection#SYNCED_SITES_SEARCH_FIELD",
			value1 = "\ENTER");

		Click.Click(locator1 = "AnalyticsCloudConnection#INPUT_LIFERAY_DXP_CHECKBOX");

		Click.Click(locator1 = "AnalyticsCloudConnection#DONE_BUTTON");

		//Click(locator1 = "AnalyticsCloudConnection#SYNCED_CONTACT_DATA_LINK");
		//Click(locator1 = "AnalyticsCloudConnection#SYNCED_CONTACTS_BUTTON");
		//Check.checkToggleSwitch(locator1 = "AnalyticsCloudConnection#SYNC_ALL_CONTACTS_TOGGLE");
		//Click(locator1 = "AnalyticsCloudConnection#SAVE_AND_NEXT_BUTTON");
		//Click(locator1 = "Button#SAVE");

	}

	macro takeInvalidTokenFromAnalyticsCloud {
		Click.Click(locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_SETTINGS_BUTTON");

		Click.Click(locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_ADD_DATA_SOURCE_BUTTON");

		Click.Click(locator1 = "AnalyticsCloudConnection#LIFERAY_DXP_SOURCE");

		Click.Click(locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_CONNECT_WITH_TOKEN_BUTTON");

		Click.Click(locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_TOKEN_INPUT");

		Copy.Copy(locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_TOKEN_INPUT");

		ACUtils.launchDXP();

		ACDXPSettings.goToInstanceSettingsAC();

		Click.Click(locator1 = "ACDXPSettings#TOKEN_INPUT_FIELD");

		Type.Type(
			locator1 = "ACDXPSettings#TOKEN_INPUT_FIELD",
			value1 = "TEST123");

		Click.Click(locator1 = "ACDXPSettings#CONNECT_DISCONNECT_BUTTON");

		Alert.viewErrorMessage(errorMessage = "Your request failed to complete.");
	}

	macro takeTokenFromAnalyticsCloud {
		Click.Click(locator1 = "AnalyticsCloudConnection#FARO_WORKSPACE_BUTTON");

		if (IsElementPresent.IsElementPresent(locator1 = "AnalyticsCloudConnection#INTRODUCING_PROPERTIES_NEXT_BUTTON")) {
			Click.Click(locator1 = "AnalyticsCloudConnection#INTRODUCING_PROPERTIES_NEXT_BUTTON");

			Click.Click(locator1 = "AnalyticsCloudConnection#SKIP_FOR_NOW_BUTTON");
		}

		Click.Click(locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_SETTINGS_BUTTON");

		Click.Click(locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_ADD_DATA_SOURCE_BUTTON");

		Click.Click(locator1 = "AnalyticsCloudConnection#LIFERAY_DXP_SOURCE");

		Click.Click(locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_CONNECT_WITH_TOKEN_BUTTON");

		Click.Click(locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_TOKEN_INPUT");

		Copy.Copy(locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_TOKEN_INPUT");
	}

	macro teardownAnalyticsCloud {
		ApplicationsMenu.gotoPortlet(
			category = "Configuration",
			panel = "Control Panel",
			portlet = "Instance Settings");

		Click.Click(locator1 = "AnalyticsCloudConnection#ANALYTICS_CLOUD_DXP_BUTTON");

		ClickNoError.ClickNoError(locator1 = "AnalyticsCloudConnection#DISCONNECT_ANALYTICS_CLOUD_BUTTON");

		AssertConfirm.assertConfirmationNoError(value1 = "Are you sure you want to disconnect your Analytics Cloud workspace from this DXP instance?");
	}

}