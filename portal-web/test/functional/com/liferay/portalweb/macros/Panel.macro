definition {

	macro expandPanel {
		Portlet.waitForForm();

		var key_panel = "${panel}";

		AssertVisible.AssertVisible(
			key_panel = "${panel}",
			locator1 = "Panel#PANEL");

		if ((IsElementPresent.IsElementPresent(locator1 = "Panel#PANEL_COLLAPSED")) && (IsVisible.IsVisible(locator1 = "Panel#PANEL_COLLAPSED"))) {
			AssertClick.AssertClick(
				locator1 = "Panel#PANEL_COLLAPSED",
				value1 = "${panel}");
		}

		AssertElementPresent.AssertElementPresent(locator1 = "Panel#PANEL_EXPANDED");
	}

}