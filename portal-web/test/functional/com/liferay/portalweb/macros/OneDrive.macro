definition {

	macro AddDocument {
		Alert.viewInfoMessageSpecific(infoMessage = "The document has been checked out, please on finish editing check in the document to save changes into the document library.");

		Type.Type(
			locator1 = "TextInput#TITLE",
			value1 = "${dmDocumentTitle}");

		Click.Click(locator1 = "Button#SAVE");

		Pause.Pause(locator1 = "10000");

		SelectWindow.selectPopUp(locator1 = "null");

		if (IsElementNotPresent.IsElementNotPresent(locator1 = "IFrame#WEB_APPLICATION")) {
			Close.closeWindow(locator1 = "null");

			Navigator.openURL();

			Navigator.gotoPage(pageName = "Documents and Media Page");

			DMDocument.deletePG(dmDocumentTitle = "${dmDocumentTitle}");

			DMNavigator.gotoAddDocumentTypePG(dmDocumentTypeName = "${dmDocumentTypeName}");

			Type.Type(
				locator1 = "TextInput#TITLE",
				value1 = "${dmDocumentTitle}");

			Click.Click(locator1 = "Button#SAVE");

			Pause.Pause(locator1 = "10000");

			SelectWindow.selectPopUp(locator1 = "null");
		}

		SelectFrame.selectFrameNoLoading(locator1 = "IFrame#WEB_APPLICATION");

		Pause.Pause(locator1 = "10000");

		if (isSet(dmDocumentContent)) {
			WaitForElementPresent.WaitForElementPresent(locator1 = "OneDrive#DOCUMENTS_CONTENT");

			Type.sendKeys(
				locator1 = "OneDrive#DOCUMENTS_CONTENT",
				value1 = "${dmDocumentContent}");

			WaitForElementPresent.WaitForElementPresent(locator1 = "OneDrive#DOCUMENTS_SAVE_STATUS");
		}

		Navigator.closeWindow();

		SelectFrameTop.SelectFrameTop();
	}

	macro deleteDocument {
		var key_documentTitle = "${dmDocumentTitle}";

		while (IsElementPresent.IsElementPresent(locator1 = "OneDrive#FILES_TITLE")) {
			Click.mouseOverClick(locator1 = "OneDrive#FILES_CHECKBOX");

			Click.Click(locator1 = "OneDrive#DELETE");

			Click.Click(locator1 = "OneDrive#DELETE_CONFIRMATION");

			Pause.Pause(locator1 = "3000");
		}
	}

	macro editTitle {
		Pause.Pause(locator1 = "10000");

		WaitForPageLoad.WaitForPageLoad();

		SelectWindow.selectPopUp(locator1 = "null");

		SelectFrame.selectFrameNoLoading(locator1 = "IFrame#WEB_APPLICATION");

		Click.Click(locator1 = "OneDrive#DOCUMENTS_TITLE");

		if (IsElementNotPresent.IsElementNotPresent(locator1 = "OneDrive#DOCUMENTS_TITLE_RENAME")) {
			while (IsElementNotPresent.IsElementNotPresent(locator1 = "OneDrive#DOCUMENTS_TITLE_RENAME")) {
				Click.Click(locator1 = "OneDrive#DOCUMENTS_TITLE");
			}
		}

		Type.Type(
			locator1 = "OneDrive#DOCUMENTS_TITLE_RENAME",
			value1 = "${dmDocumentTitle}");

		KeyPress.KeyPress(
			locator1 = "OneDrive#DOCUMENTS_TITLE_RENAME",
			value1 = "\RETURN");

		WaitForPageLoad.WaitForPageLoad();

		WaitForElementPresent.WaitForElementPresent(locator1 = "OneDrive#DOCUMENTS_SAVE_STATUS");

		Navigator.closeWindow();

		SelectFrameTop.SelectFrameTop();
	}

	macro gotoEdit {
		var key_dmDocumentTitle = "${dmDocumentTitle}";

		Click.Click(locator1 = "DocumentsAndMedia#DESCRIPTIVE_LIST_DOCUMENT_VERTICAL_ELLIPSIS");

		MenuItem.click(menuItem = "Edit in Office 365");
	}

	macro goToOneDrive {
		Navigator.openSpecificURL(url = "https://liferaycolab-my.sharepoint.com/personal/sharepoint_liferaycolab_onmicrosoft_com/_layouts/15/onedrive.aspx");

		Pause.Pause(locator1 = "10000");

		MicrosoftLogin.accountSignIn(
			userEmail = "${userName}",
			userPassword = "${userPassword}",
			windowTitle = "Sign in to your account");

		MicrosoftLogin.confirmMicrosoftApp();

		Pause.Pause(locator1 = "30000");

		SelectWindow.selectPopUp(locator1 = "null");
	}

}