definition {

	macro addVideoId {
		SelectFrame.SelectFrame(locator1 = "IFrame#MODAL_BODY");

		Type.Type(
			locator1 = "TextInput#URL",
			value1 = "${videoId}");
	}

	macro assertVideoTitle {
		SelectFrame.selectFrameNoLoading(locator1 = "YoutubePortlet#VIDEO_IFRAME");

		AssertTextEquals.assertPartialText(
			locator1 = "YoutubePortlet#VIDEO_TITLE",
			value1 = "${videoTitle}");

		SelectFrameTop.SelectFrameTop();
	}

	macro viewPortletConfiguration {
		SelectFrame.SelectFrame(locator1 = "IFrame#MODAL_BODY");

		AssertTextEquals.AssertTextEquals(
			locator1 = "TextInput#URL",
			value1 = "${videoId}");
	}

}