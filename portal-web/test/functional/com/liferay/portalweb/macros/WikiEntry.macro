definition {

	macro addPageContent {
		SelectFrame.selectFrameNoLoading(locator1 = "CKEditor#BODY_FIELD_IFRAME");

		Type.Type(
			locator1 = "CKEditor#BODY",
			value1 = "${wikiPageContent}");

		SelectFrame.SelectFrame(value1 = "relative=top");
	}

	macro addPageTitle {
		if (isSet(wikiPageTitle)) {
			var title = "${wikiPageTitle}";
		}
		else if (isSet(wikiChildPageTitle)) {
			var title = "${wikiChildPageTitle}";
		}

		Type.Type(
			locator1 = "Wiki#ENTRY_TITLE",
			value1 = "${title}");
	}

	macro cancel {
		AssertClick.AssertClick(
			locator1 = "Button#CANCEL",
			value1 = "Cancel");
	}

	macro confirmHTML {
		AssertConfirm.AssertConfirm(value1 = "You may lose some formatting when switching from Creole to HTML. Do you want to continue?");
	}

	macro saveAsDraft {
		AssertClick.AssertClick(
			locator1 = "Button#SAVE",
			value1 = "Save as Draft");

		Alert.viewSuccessMessage();
	}

	macro selectPageFormat {
		if (IsNotVisible.IsNotVisible(locator1 = "Wiki#ADD_PAGE_FORMAT_DROPDOWN")) {
			Panel.expandPanel(panel = "Configuration");

			SelectNoError.SelectNoError(
				locator1 = "Wiki#ADD_PAGE_FORMAT_DROPDOWN",
				value1 = "${pageFormat}");
		}
		else if (IsVisible.IsVisible(locator1 = "Wiki#ADD_PAGE_FORMAT_DROPDOWN")) {
			SelectNoError.SelectNoError(
				locator1 = "Wiki#ADD_PAGE_FORMAT_DROPDOWN",
				value1 = "${pageFormat}");
		}
	}

	macro viewPageContentBody {
		AssertTextEquals.AssertTextEquals(
			locator1 = "WikiEntry#BODY",
			value1 = "${wikiPageContent}");
	}

}