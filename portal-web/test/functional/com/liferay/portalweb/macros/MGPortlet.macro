definition {

	macro configureShowAllPG {
		Portlet.gotoPortletOptions(
			portletName = "Media Gallery",
			portletOption = "Configuration");

		SelectFrame.SelectFrame(locator1 = "IFrame#CONFIGURATION");

		Pause.Pause(locator1 = "5000");

		WaitForElementPresent.WaitForElementPresent(locator1 = "Checkbox#SHOW_ACTIONS_CHECKBOX");

		Check.Check(locator1 = "Checkbox#SHOW_ACTIONS_CHECKBOX");

		PortletEntry.save();
	}

	macro viewCustomADTCarouselPG {
		AssertElementPresent.AssertElementPresent(locator1 = "MediaGallery#ADT_CAROUSEL_ITEM");

		AssertElementPresent.AssertElementPresent(locator1 = "MediaGallery#ADT_CAROUSEL_PLAY_PAUSE");

		AssertElementPresent.AssertElementPresent(locator1 = "MediaGallery#ADT_CAROUSEL_PREVIOUS_ARROW");

		AssertElementPresent.AssertElementPresent(locator1 = "MediaGallery#ADT_CAROUSEL_NEXT_ARROW");

		AssertElementPresent.AssertElementPresent(locator1 = "MediaGallery#ADT_CAROUSEL_MENU_INDEX");
	}

	macro viewShowAllPG {
		Click.waitForMenuToggleJSClick(locator1 = "Icon#BODY_VERTICAL_ELLIPSIS");

		for (var menuItem : list "Permissions,Multiple Media,Add Shortcut,Access from Desktop") {
			MenuItem.viewPresent(menuItem = "${menuItem}");
		}
	}

}