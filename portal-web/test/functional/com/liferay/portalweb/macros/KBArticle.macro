	macro viewKBDisplayPG {
		if ("${sourceURL}" == "true") {
			AssertClick.AssertClick(
				locator1 = "KnowledgeBaseArticle#EDIT_ON_GITHUB",
				value1 = "Edit On GitHub");

			SelectWindow.SelectWindow(
				key_pageTitle = "Google",
				locator1 = "Google#PAGE_TITLE");

			var url = selenium.getLocation();

			if ("${url}" != "https://www.google.com/[#]gws_rd=ssl") {
				AssertLocation.AssertLocation(value1 = "https://www.google.com/?gws_rd=ssl");
			}
			else {
				AssertLocation.AssertLocation(value1 = "https://www.google.com/[#]gws_rd=ssl");
			}

			Close.Close(
				key_pageTitle = "Google",
				locator1 = "Google#PAGE_TITLE");
		}

		if ("${subscribe}" == "true") {
			AssertElementPresent.AssertElementPresent(locator1 = "KnowledgeBaseArticle#SUBSCRIBE");
		}
		else if ("${subscribe}" == "false") {
			AssertElementNotPresent.AssertElementNotPresent(locator1 = "KnowledgeBaseArticle#SUBSCRIBE");
		}

		if ("${history}" == "true") {
			AssertElementPresent.AssertElementPresent(locator1 = "KnowledgeBaseArticle#HISTORY");
		}
		else if ("${history}" == "false") {
			AssertElementNotPresent.AssertElementNotPresent(locator1 = "KnowledgeBaseArticle#HISTORY");
		}

		if ("${print}" == "true") {
			AssertElementPresent.AssertElementPresent(locator1 = "KnowledgeBaseArticle#PRINT");
		}
		else if ("${print}" == "false") {
			AssertElementNotPresent.AssertElementNotPresent(locator1 = "KnowledgeBaseArticle#PRINT");
		}
	}

