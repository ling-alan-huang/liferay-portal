definition {

	macro gotoDrive {
		AssertElementPresent.pauseAssertVisible(locator1 = "Button#SELECT_FILE");

		AssertClick.AssertClick(
			locator1 = "Button#SELECT_FILE",
			value1 = "Select File");

		Pause.Pause(locator1 = "3000");

		if (isSet(windowTitle)) {
			SelectWindow.SelectWindow(locator1 = "GoogleLogin#PAGE_TITLE");

			if (IsElementPresent.IsElementPresent(locator1 = "GoogleLogin#HEADER")) {
				AssertClick.AssertClick(
					locator1 = "GoogleLogin#ACCOUNT_MENULIST_USE_ANOTHER_ACCOUNT",
					value1 = "Use another account");
			}

			Type.Type(
				locator1 = "GoogleLogin#LOGIN_EMAIL_FIELD",
				value1 = "${userEmailAddress}");

			Click.Click(locator1 = "GoogleLogin#LOGIN_NEXT_BUTTON");

			AssertElementPresent.AssertElementPresent(locator1 = "GoogleLogin#LOGIN_NEXT_BUTTON");

			Type.Type(
				locator1 = "GoogleLogin#LOGIN_PASSWORD_FIELD",
				value1 = "${userPassword}");

			Click.Click(locator1 = "GoogleLogin#LOGIN_NEXT_BUTTON");

			SelectWindow.selectWindowNoSPARefresh(locator1 = "title=${windowTitle}");

			Pause.Pause(locator1 = "3000");
		}

		if (IsElementNotPresent.IsElementNotPresent(locator1 = "GoogleDrive#GOOGLE_DRIVE_IFRAME")) {
			Refresh.Refresh();

			AssertElementPresent.pauseAssertVisible(locator1 = "Button#SELECT_FILE");

			AssertClick.AssertClick(
				locator1 = "Button#SELECT_FILE",
				value1 = "Select File");

			SelectWindow.selectWindowNoSPARefresh(locator1 = "title=${windowTitle}");
		}

		SelectFrame.selectFrameNoLoading(locator1 = "GoogleDrive#GOOGLE_DRIVE_IFRAME");
	}

	macro selectDocument {
		var key_googleDocName = "${googleDocName}";

		if (IsElementNotPresent.IsElementNotPresent(locator1 = "GoogleDrive#LIST_VIEW_DOCUMENT_SPECIFIC")) {
			Click.Click(locator1 = "GoogleDrive#LIST_VIEW_BUTTON");
		}

		Click.Click(
			locator1 = "GoogleDrive#LIST_VIEW_DOCUMENT_SPECIFIC",
			value1 = "${googleDocName}");

		ClickNoError.ClickNoError(
			locator1 = "GoogleDrive#SELECT_BUTTON",
			value1 = "Select");

		SelectFrameTop.SelectFrameTop();

		var key_dmDocumentTitle = "${googleDocTitle}";

		AssertTextEquals.AssertTextEquals(
			locator1 = "DocumentsAndMediaEntry#SELECTED_DOCUMENT_TITLE",
			value1 = "${googleDocTitle}");
	}

}