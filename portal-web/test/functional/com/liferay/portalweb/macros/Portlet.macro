	macro viewPortletOptions {
		MouseOver.mouseOverNotVisible(locator1 = "Portlet#OPTIONS_ICON");

		Click.Click(locator1 = "Portlet#OPTIONS_ICON");

		AssertTextEquals.AssertTextEquals(
