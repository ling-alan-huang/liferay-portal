@component-name = "portal-questions"
definition {

	property portal.release = "true";
	property portal.upstream = "true";
	property testray.main.component.name = "Questions";

	setUp {
		TestCase.setUpPortalInstance();

		User.firstLoginPG();

		JSONLayout.addPublicLayout(
			groupName = "Guest",
			layoutName = "Questions Page");

		JSONLayout.addWidgetToPublicLayout(
			column = "2",
			groupName = "Guest",
			layoutName = "Questions Page",
			widgetName = "Questions");
	}

	tearDown {
		var testPortalInstance = PropsUtil.get("test.portal.instance");

		if ("${testPortalInstance}" == "true") {
			PortalInstances.tearDownCP();
		}
		else {
			ProductMenu.gotoPortlet(
				category = "Content & Data",
				portlet = "Message Boards");

			if (IsElementPresent.IsElementPresent(locator1 = "Questions#QUESTIONS_LIST")) {
				Questions.tearDown();
			}

			Page.tearDownCP();
		}
	}

	@description = "Validate if the user can add multiple subtopics with non-Latin characters."
	@priority = "3"
	@refactordone
	test CanAddMultipleSubTopics {
		JSONMBMessage.addCategory(
			categoryDescription = "銉堛償銉冦偗瑷樿堪",
			categoryName = "璩晱銉堛償銉冦偗",
			userEmailAddress = "test@liferay.com");

		for (var subTopicName : list "銇嬨仾銇屻倧銇戙倱,濂堣壇鐪�") {
			Navigator.gotoPage(pageName = "Questions Page");

			Questions.gotoCategory(categoryName = "璩晱銉堛償銉冦偗");

			Questions.addSubTopic(
				subTopicDescription = "銉堛償銉冦偗瑷樿堪",
				subTopicName = "${subTopicName}");

			Questions.changeTopic(gotoParentTopic = "璩晱銉堛償銉冦偗");

			Questions.changeTopic(
				parentTopicName = "璩晱銉堛償銉冦偗",
				subTopicName = "${subTopicName}");
		}
	}

	@description = "Validate if the user can post a question with non-Latin characters via subtopic."
	@priority = "4"
	@refactordone
	test CanAddQuestionViaSubTopic {
		JSONMBMessage.addCategory(
			categoryDescription = "銉堛償銉冦偗瑷樿堪",
			categoryName = "璩晱銉堛償銉冦偗",
			userEmailAddress = "test@liferay.com");

		Navigator.gotoPage(pageName = "Questions Page");

		Questions.gotoCategory(categoryName = "璩晱銉堛償銉冦偗");

		Questions.addSubTopic(
			subTopicDescription = "銉堛償銉冦偗瑷樿堪",
			subTopicName = "銈点儢銉嗐兗銉�");

		Questions.changeTopic(
			parentTopicName = "璩晱銉堛償銉冦偗",
			subTopicName = "銈点儢銉嗐兗銉�");

		Questions.askQuestionFillingTheMandatoryFields(
			contentField = "绉併伄濂姐亶銇棩鏈枡鐞嗐伅瀵垮徃銇ㄣ仚銇嶇劶銇嶃仹銇�",
			titleField = "銇傘仾銇熴伄濂姐亶銇棩鏈枡鐞嗐伅浣曘仹銇欍亱");

		Navigator.gotoPage(pageName = "Questions Page");

		Questions.gotoCategory(categoryName = "璩晱銉堛償銉冦偗");

		Questions.changeTopic(
			parentTopicName = "璩晱銉堛償銉冦偗",
			subTopicName = "銈点儢銉嗐兗銉�");

		Questions.viewList(listedQuestions = "銇傘仾銇熴伄濂姐亶銇棩鏈枡鐞嗐伅浣曘仹銇欍亱");
	}

	@description = "Validate if the user can post a question with multiple tags that contain non-Latin characters."
	@priority = "3"
	@refactordone
	test CanAddQuestionWithMultipleTags {
		JSONMBMessage.addCategory(
			categoryDescription = "銉堛償銉冦偗瑷樿堪",
			categoryName = "璩晱銉堛償銉冦偗",
			userEmailAddress = "test@liferay.com");

		Questions.askQuestionFillingTheMandatoryFields(
			contentField = "绉併伄濂姐亶銇棩鏈枡鐞嗐伅瀵垮徃銇ㄣ仚銇嶇劶銇嶃仹銇�",
			layoutName = "questions-page",
			siteURLKey = "guest",
			tagLocatorList = "銇勩仭,銇�,銇曘倱,銇�,銇�",
			titleField = "銇傘仾銇熴伄濂姐亶銇棩鏈枡鐞嗐伅浣曘仹銇欍亱",
			topicName = "璩晱銉堛償銉冦偗");

		AssertTextEquals.AssertTextEquals(
			key_questionTitle = "銇傘仾銇熴伄濂姐亶銇棩鏈枡鐞嗐伅浣曘仹銇欍亱",
			locator1 = "Questions#QUESTIONS_TITLE",
			value1 = "銇傘仾銇熴伄濂姐亶銇棩鏈枡鐞嗐伅浣曘仹銇欍亱");
	}

	@description = "Validate if the user can post a question with non-Latin characters锛� it also covers LPS-128639."
	@priority = "5"
	@refactordone
	@uitest
	test CanAddQuestionWithNonLatinCharacters {
		Navigator.gotoPage(pageName = "Questions Page");

		Questions.addRootTopic(
			rootTopicDescription = "銉堛償銉冦偗瑷樿堪",
			rootTopicName = "璩晱銉堛償銉冦偗");

		Navigator.gotoPage(pageName = "Questions Page");

		Questions.gotoCategory(categoryName = "璩晱銉堛償銉冦偗");

		Questions.askQuestionFillingTheMandatoryFields(
			contentField = "绉併伄濂姐亶銇棩鏈枡鐞嗐伅瀵垮徃銇ㄣ仚銇嶇劶銇嶃仹銇�",
			titleField = "銇傘仾銇熴伄濂姐亶銇棩鏈枡鐞嗐伅浣曘仹銇欍亱");

		Navigator.gotoPage(pageName = "Questions Page");

		Questions.gotoCategory(categoryName = "璩晱銉堛償銉冦偗");

		Questions.gotoDetails(questionTitle = "銇傘仾銇熴伄濂姐亶銇棩鏈枡鐞嗐伅浣曘仹銇欍亱");
	}

