package com.liferay.source.formatter.dependencies;

import com.liferay.portal.kernel.workflow.WorkflowConstants;

/**
 * @author Qi Zhang
 */
public class UpgradeSQLStatementUpgradeProcess {

	public void doUpgrade() throws Exception {
		runSQL("UPDATE CommercePriceEntry SET bulkPricing = [$TRUE$]");
		runSQL("UPDATE CommercePriceEntry SET displayDate = lastPublishDate");
		runSQL(
			"UPDATE CommercePriceEntry SET status = " +
				WorkflowConstants.STATUS_APPROVED);
		runSQL("UPDATE CommercePriceEntry SET statusByUserId = userId");
		runSQL("UPDATE CommercePriceEntry SET statusByUserName = userName");
		runSQL("UPDATE CommercePriceEntry SET statusDate = modifiedDate");

		runSQL(
        	StringBundler.concat(
				"update Role_ set type_ = ", newType,
				" where classNameId = (SELECT ClassName_.classNameId from ",
        		"ClassName_ where ClassName_.value = ", className,
        		") and type_ = ", oldType));

		String when = "TODAY";
        String who = "WE";

		runSQL(
			StringBundler.concat(
				"update table set title = '", who,
				" CAN USE ''TABLE'' AS A TABLE NAME!", when, "!'"));

		runSQL("select a, '', 'c' as b WHERE c='' AND d=''");

		String keyword = "UPDATE";

		runSQL(
			"update table set title = '''" + keyword +
			"'' IS A KEYWORD DO NOT USE IT!'");
	}

}