public class TestResourceFactoryImpl {

	private Object _invoke() {
		<#if generateFeatureFlag>
			if (!_featureFlagChecker.isEnabled()) {
				throw new NotFoundException();
			}

		</#if>
		String name = PrincipalThreadLocal.getName();

		return name;
	}

	<#list items as item>
		<#if generateFeatureFlag>
			if (!_featureFlagChecker.isEnabled()) {
				throw new NotFoundException();
			}

		</#if>
	</#list>

}