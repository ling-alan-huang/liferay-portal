SELECT
 COUNT(*)
FROM
 table1
INNER JOIN
 table2
ON
 table1.col1 = table2.col1
WHERE
 table1.col2 = ?;

SELECT
 table1.col1, table1.col2, table1.col3
FROM
 testTable table1
INNER JOIN
 table table2
ON
 table1.col1 = table2.col2
WHERE
 table1.name = ? AND
 (
  table1.col3 = [$TEST_ID$] OR
  table1.col4 = 0 AND
  table1.col5 NOT IN (
   SELECT
    table3.col1
   FROM
    table3
   WHERE
    table3.col1 = [$TEST_ID$] AND
    table3.col2 = [$TEST_ID$]
  )
 ) AND
 (
  table2.col3 = [$TEST_ID$] OR
  table2.col4 = 0 AND
  table2.col5 NOT IN (
   SELECT
    table4.col1
   FROM
    table4
   WHERE
    table4.col1 = [$TEST_ID$] AND
    table4.col2 = [$TEST_ID$]
  )
 )
ORDER BY
 table1.col1 ASC;

(
 SELECT
  COUNT(*)
 FROM
  table1
)
UNION ALL
(
 SELECT
  COUNT(*)
 FROM
  table2
);

UPDATE
 table1
SET
 col1 = ?
WHERE
 table1.col1 = ?;

update table1 set col1 = (select col1 from table2 where table2.col1 = table1.col1);

SELECT
 table1.col1, table1.col2
FROM
 table1
LEFT JOIN
 table1 tempMainTable
ON
 table1.col1 < tempMainTable.col1 AND
 (table1.col2 = 0 OR table1.col2 IS NULL) AND
 (tempMainTable.col2 = 0 OR tempMainTable.col2 IS NULL)
WHERE
 tempMainTable.col1 IS NULL AND
 (table1.col2 = 0 OR table1.col2 IS NULL) AND
 (tempMainTable.col2 = 0 OR tempMainTable.col2 IS NULL);