package com.liferay.source.formatter.dependencies;

import org.json.JSONObject;

/**
 * @author Qi Zhang
 */
public class ChainingOnReturnStatement {

	public JSONObject testMethod(String parameter) {
		return parameter.substring(
			1
		).toUpperCase() + parameter;
	}

}