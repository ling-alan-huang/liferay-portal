package com.liferay.source.formatter.dependencies;

import com.liferay.portal.kernel.json.JSONObject;
import com.liferay.portal.kernel.json.JSONUtil;

/**
 * @author Qi
 */
public class JsonPutCallMethod {

	public void test(
		String editInProduction, String leftPreview, String query,
		String fuzziness, String operator) {

		JSONObject jsonObject = JSONUtil.put(
			"key", "key"
		).put(
			"operator", "operator"
		);

		if (editInProduction != null) {
			jsonObject.put("editInProduction", editInProduction);
		}

		if (leftPreview != null) {
			jsonObject.put("leftPreview", leftPreview);
		}

		if (query != null) {
			jsonObject.put("query", query);
		}

		JSONObject resultJSONObject = JSONUtil.put(
			"multi_match",
			JSONUtil.put(
				"key", "key"
			).put(
				"operator", "operator"
			));

		if (fuzziness != null) {
			resultJSONObject.put("fuzziness", fuzziness);
		}

		if (operator != null) {
			resultJSONObject.put("operator", operator);
		}

		return jsonObject.put(
			"key", resultJSONObject
		).toString();
	}

}